# Local development only. Copy to .env; never commit .env.
DATABASE_URL=postgresql://supportiq:local-db-password@127.0.0.1:5433/supportiq
TEST_DATABASE_URL=postgresql://supportiq:local-db-password@127.0.0.1:5433/supportiq_test
APP_ORIGIN=http://localhost:3000
API_PORT=4000
API_INTERNAL_URL=http://127.0.0.1:4000
CSRF_SECRET=replace-with-at-least-32-random-characters
POSTGRES_PASSWORD=local-db-password
MINIO_ROOT_USER=supportiq-local
MINIO_ROOT_PASSWORD=replace-local-storage-password
SEED_PASSWORD=choose-a-local-demo-password-at-least-12-characters
# Only for an explicitly run public-demo seed; its shared agent/customer
# credentials are intentionally public and limited to synthetic demo data.
ENABLE_PUBLIC_DEMO_SEED=
PUBLIC_DEMO_PASSWORD=
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=SupportIQ <support@localhost>
STORAGE_ENDPOINT=http://127.0.0.1:9100
STORAGE_BUCKET=supportiq-private
STORAGE_REGION=us-east-1
# Optional: set AES256 when the configured S3-compatible service supports it.
STORAGE_SERVER_SIDE_ENCRYPTION=
# Storage credentials fall back to MINIO_ROOT_USER and MINIO_ROOT_PASSWORD.
OLLAMA_URL=http://127.0.0.1:11434
# Set only after manually installing models; SupportIQ never downloads models.
OLLAMA_EMBEDDING_MODEL=
OLLAMA_CHAT_MODEL=
# Hosted inference is optional. Local development defaults to Ollama.
AI_PROVIDER=ollama
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Public $0 demo uses Gemini's unpaid API quota. Keep this key server-side,
# do not configure Google Cloud billing, and use synthetic ticket content only.
GEMINI_API_KEY=
GEMINI_GENERATION_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# Production public-demo quotas; values are bounded server-side.
DEMO_DAILY_DRAFT_LIMIT=20
DEMO_DAILY_KNOWLEDGE_UPLOAD_LIMIT=4
DEMO_DAILY_TICKET_LIMIT=40
DEMO_DAILY_MESSAGE_LIMIT=200
DEMO_DAILY_ATTACHMENT_LIMIT=20
DEMO_DAILY_ATTACHMENT_DOWNLOAD_LIMIT=100
DEMO_DAILY_SEARCH_LIMIT=60
DEMO_DAILY_EMAIL_LIMIT=1
# MAIL_MODE=disabled is appropriate for the public $0 demo; local uses Mailpit.
MAIL_MODE=smtp
# Trust one managed proxy only when the backend is private behind the frontend.
TRUST_PROXY_HOPS=0
# For an S3-compatible managed provider, configure a private bucket and scoped keys.
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# SMTP delivery provider; set credentials only in the deployment secret store.
SMTP_USER=
SMTP_PASSWORD=
